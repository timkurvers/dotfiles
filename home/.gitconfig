[color]
	ui = true
[commit]
	gpgsign = true
[core]
	commentChar = ";"
	excludesfile = ~/.gitignore
	editor = /usr/bin/vim
[push]
	autoSetupRemote = true
	default = simple
	followTags = true
[pull]
	ff = only
[user]
	name = Tim Kurvers
	email = tim@moonsphere.net
	signingkey = E5E6D4ED4C82A59B
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[alias]
	authors = shortlog -ens --all
	changes = !git add -N . && git -P diff $1 && git reset --quiet && :
	rob = !git branch | egrep -v \"(^\\*|master)\" | xargs -p -I % git branch -D %
	stash-rename = "!f() { test $# -eq 2 || { echo \"usage: git stash-rename <stash> <message>\" >&2; return 1; }; rev=$(git rev-parse --verify --quiet \"$1\") || return 1; git stash drop \"$1\" || return 1; git stash store -m \"$2\" \"$rev\"; }; f"
	stash-staged = !git stash push --staged
[include]
	path = ~/.gitconfig-local
